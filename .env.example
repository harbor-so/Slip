# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Swap this one line for a Supabase/Neon/RDS URL to run hosted —
# nothing else in the codebase constructs a client.
DATABASE_URL=postgres://harbor:harbor@localhost:5433/harbor

# Encrypts secrets, source-control tokens and connector credentials at rest.
#   openssl rand -base64 32
# There is deliberately no fallback and Harbor will not generate one: a key
# invented at boot changes at the next boot, and every secret already stored
# becomes permanently unreadable with no error until somebody starts a session.
HARBOR_ENCRYPTION_KEY=

# Signs dashboard session cookies. Required in production; absence is fatal at
# the first request rather than silently insecure.
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Dashboard sign-in (GitHub OAuth)
# ---------------------------------------------------------------------------
# Callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to join on first sign-in. Required for
# anyone to sign in at all — an empty list refuses everybody rather than
# admitting everybody.
HARBOR_ALLOWED_GITHUB_LOGINS=

# Where this deployment is reachable. Used in links Harbor posts back to Slack
# and Linear, so a wrong value produces messages nobody can click.
HARBOR_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

# docker | fly | local
#
# `docker` is the default and needs no vendor account — it is what lets you run
# the entire product on a laptop or inside a VPC. `local` runs the agent as the
# server user with no isolation at all and is only reasonable on your own machine
# against your own repository; see docs/SECURITY.md.
HARBOR_SANDBOX_PROVIDER=docker
HARBOR_SANDBOX_IMAGE=harbor-sandbox:latest

# Snapshot restore is a latency optimisation with sharp edges — snapshots expire,
# some provider APIs are experimental, and on at least one provider snapshotting
# can terminate the source box. Off until you opt in.
HARBOR_ENABLE_SNAPSHOTS=0

# The `local` provider, which is not a sandbox. Both are required to enable it.
HARBOR_ENABLE_RUNNER=
HARBOR_WORKSPACE_DIR=

# ---------------------------------------------------------------------------
# Source control
# ---------------------------------------------------------------------------
# A GitHub App, not an OAuth app: installation tokens are what let the sandbox
# push without carrying anyone's personal credential.
SCM_PROVIDER=github
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Used by the weekly digest and, optionally, by connector routing. Routing works
# without it — explicit targets, channel mappings and keyword rules resolve most
# traffic, and anything left over produces a picker rather than a guess.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Tuning — every one of these has a documented default. See src/config.ts, or
# GET /api/health/config on a running deployment, which prints the resolved
# value, where it came from, and why the default is what it is.
# ---------------------------------------------------------------------------

# $50/day per organisation, in millionths of a dollar. A default rather than
# unlimited, because every amplification path in a background agent platform —
# scheduled automations, child sessions, connectors, retries — is a loop with no
# human in it. On breach Harbor stops admitting new claims and does not kill
# running work.
HARBOR_MAX_SPEND_PER_DAY_MICRO_USD=50000000

# Raise this first if your repository legitimately takes longer to boot.
HARBOR_SANDBOX_BOOT_TIMEOUT_MS=180000

# The single largest lever on cost: how long an idle sandbox survives before it
# is snapshotted and stopped.
HARBOR_SANDBOX_INACTIVITY_TIMEOUT_MS=900000
