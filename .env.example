# Postgres. Swap this one line for a Supabase/Neon URL to deploy hosted.
DATABASE_URL=postgres://slip:slip@localhost:5433/slip

# Digest generation. Without it, /api/digest/generate returns a clear error
# rather than a fake summary.
ANTHROPIC_API_KEY=

# Dashboard auth (GitHub OAuth). Callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to join on first sign-in. Required for
# anyone to sign in at all — an empty list refuses everybody rather than
# admitting everybody.
SLIP_ALLOWED_GITHUB_LOGINS=
# Required in production; generate with: openssl rand -base64 32
AUTH_SECRET=

# Connector webhook verification.
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
