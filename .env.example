# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Swap this one line for a Supabase/Neon/RDS URL to run hosted —
# nothing else in the codebase constructs a client.
DATABASE_URL=postgres://harbor:harbor@localhost:5433/harbor

# Encrypts secrets, source-control tokens and connector credentials at rest.
#   openssl rand -base64 32
# There is deliberately no fallback and Harbor will not generate one: a key
# invented at boot changes at the next boot, and every secret already stored
# becomes permanently unreadable with no error until somebody starts a session.
HARBOR_ENCRYPTION_KEY=

# Signs dashboard session cookies. Required in production; absence is fatal at
# the first request rather than silently insecure.
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Dashboard sign-in (GitHub OAuth)
# ---------------------------------------------------------------------------
# Callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to join on first sign-in. Required for
# anyone to sign in at all — an empty list refuses everybody rather than
# admitting everybody.
HARBOR_ALLOWED_GITHUB_LOGINS=

# Where this deployment is reachable. Used in links Harbor posts back to Slack
# and Linear, so a wrong value produces messages nobody can click.
HARBOR_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Maintenance ticks — only if you deploy the dashboard WITHOUT `npm run mcp`
# ---------------------------------------------------------------------------
# The background sweeps (expired leases, sandbox deadlines, event compaction)
# run in the `npm run mcp` process. The Next.js app deliberately starts none: it
# is serverless-shaped and may have zero warm instances, so a timer there is a
# promise the runtime cannot keep.
#
# If you run BOTH processes, leave this empty — the loops are already running.
#
# If you deploy only the dashboard, set this to a random secret and point a cron
# at the endpoint, or nothing will ever sweep an expired lease:
#
#   openssl rand -base64 32
#   */5 * * * * curl -fsS -XPOST -H "Authorization: Bearer $TOKEN" \
#                 https://your-harbor/api/loops/tick
#
# Not an org API key on purpose: the sweeps are global, so a tenant credential
# here would let any org trigger work across every other org.
HARBOR_MAINTENANCE_TOKEN=

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

# docker | fly | local
#
# `docker` is the default and needs no vendor account — it is what lets you run
# the entire product on a laptop or inside a VPC. `fly` boots a hardware-isolated
# Machine and needs a Fly account plus FLY_API_TOKEN and FLY_APP_NAME. `local`
# runs the agent as the server user with no isolation at all and is only
# reasonable on your own machine against your own repository; see
# docs/SECURITY.md.
HARBOR_SANDBOX_PROVIDER=docker
HARBOR_SANDBOX_IMAGE=harbor-sandbox:latest

# Only for HARBOR_SANDBOX_PROVIDER=fly. The app must already exist and the image
# above must be pushed somewhere Fly can pull it.
FLY_API_TOKEN=
FLY_APP_NAME=

# Where the `harbor-agent` MCP surface is reachable FROM INSIDE a sandbox — the
# `npm run mcp` process, not the dashboard. Setting it is what gives a background
# agent report_progress, record_artifact, spawn_child and get_session_context.
#
# Leave empty if you do not run the MCP server: the agent then simply has no
# Harbor tools, which is better than pointing it at a URL that times out on every
# turn. On Docker this is usually http://host.docker.internal:8788.
HARBOR_AGENT_MCP_URL=

# Snapshot restore is a latency optimisation with sharp edges — snapshots expire,
# some provider APIs are experimental, and on at least one provider snapshotting
# can terminate the source box. Off until you opt in.
HARBOR_ENABLE_SNAPSHOTS=0

# The `local` provider, which is not a sandbox. Both are required to enable it.
HARBOR_ENABLE_RUNNER=
HARBOR_WORKSPACE_DIR=

# ---------------------------------------------------------------------------
# Source control
# ---------------------------------------------------------------------------
# A GitHub App, not an OAuth app: installation tokens are what let the sandbox
# push without carrying anyone's personal credential.
#
# User-attributed pull requests reuse the dashboard OAuth pair above
# (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET) — there is no separate
# GITHUB_APP_CLIENT_ID pair; a variable by that name is read by nothing, and a
# deployment that fills one in gets bot-attributed PRs plus the startup warning
# explaining what was lost.
SCM_PROVIDER=github
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitHub Enterprise Server deployments point Harbor at their host here.
# Defaults to github.com; derived api/web endpoints follow it.
#SCM_HOST=github.example.com

# ---------------------------------------------------------------------------
# Connectors — webhook signing secrets and, for Linear, the API key Harbor
# posts back with. (No CLIENT_ID/SECRET pairs: the connectors are configured
# per-org in the dashboard, and variables by those names are read by nothing.)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_SECRET=

LINEAR_WEBHOOK_SECRET=
LINEAR_API_KEY=

# Devin has no webhook to sign: it is a cloud agent with no hooks, so Harbor
# polls its API instead. Prefer a per-org `devin` connector row holding
# config.apiToken — a deployment serving two orgs must not poll one org's
# sessions with the other's credential. This is the single-tenant fallback.
DEVIN_API_TOKEN=
# Point the client at a proxy or a test double. Defaults to https://api.devin.ai/v1.
#DEVIN_API_BASE_URL=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Used by the weekly digest and, optionally, by connector routing. Routing works
# without it — explicit targets, channel mappings and keyword rules resolve most
# traffic, and anything left over produces a picker rather than a guess.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Tuning — every one of these has a documented default. See src/config.ts, or
# GET /api/health/config on a running deployment, which prints the resolved
# value, where it came from, and why the default is what it is.
# ---------------------------------------------------------------------------

# $50/day per organisation, in millionths of a dollar. A default rather than
# unlimited, because every amplification path in a background agent platform —
# scheduled automations, child sessions, connectors, retries — is a loop with no
# human in it. On breach Harbor stops admitting new claims and does not kill
# running work.
HARBOR_MAX_SPEND_PER_DAY_MICRO_USD=50000000

# Raise this first if your repository legitimately takes longer to boot. It
# must cover HARBOR_SETUP_TIMEOUT_MS + HARBOR_START_TIMEOUT_MS (validated at
# startup) — the outer timeout may not be smaller than the hooks' own budgets.
HARBOR_SANDBOX_BOOT_TIMEOUT_MS=480000

# Budget for .harbor/setup.sh (dependency installation; non-fatal on failure).
HARBOR_SETUP_TIMEOUT_MS=300000

# Budget for .harbor/start.sh (services the agent needs; a failure fails the boot).
HARBOR_START_TIMEOUT_MS=120000

# The single largest lever on cost: how long an idle sandbox survives before it
# is snapshotted and stopped. Must exceed HARBOR_AGENT_TURN_TIMEOUT_MS
# (validated at startup) so a long turn is not reaped as idle.
HARBOR_SANDBOX_INACTIVITY_TIMEOUT_MS=2100000

# Bridge liveness: how often a sandbox says it is alive, and how stale that
# signal may go before the box is declared dead. The stale threshold must be
# at least twice the interval (validated at startup) or every healthy sandbox
# is reaped on its first dropped packet.
#HARBOR_SANDBOX_HEARTBEAT_INTERVAL_MS=15000
#HARBOR_SANDBOX_STALE_HEARTBEAT_MS=45000

# The claim lease, in minutes: how long a task reads as held before it returns
# to the pool. The turn timeout must fit inside it (validated at startup).
#HARBOR_LEASE_MINUTES=30
#HARBOR_MAX_LEASE_MINUTES=480

# Protects GET /api/metrics when set; open (for cluster-internal scrapes) when
# not. Set it on anything internet-reachable.
#HARBOR_METRICS_TOKEN=
