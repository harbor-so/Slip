# Postgres. Swap this one line for a Supabase/Neon URL to deploy hosted.
DATABASE_URL=postgres://slip:slip@localhost:5433/slip

# Digest generation. Without it, /api/digest/generate returns a clear error
# rather than a fake summary.
ANTHROPIC_API_KEY=

# Dashboard auth (GitHub OAuth). Callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=

# Connector webhook verification.
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
